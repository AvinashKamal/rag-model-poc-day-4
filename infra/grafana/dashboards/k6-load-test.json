{
  "title": "k6 Load Test",
  "uid": "k6-load-test",
  "schemaVersion": 39,
  "tags": ["rag-poc", "k6"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Active VUs",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "k6_vus", "legendFormat": "vus", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#2a78d6" },
          "custom": { "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "http_req_duration p95 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#2a78d6" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "#0ca30c" },
              { "value": 300, "color": "#fab219" },
              { "value": 500, "color": "#d03b3b" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(k6_http_reqs_total[1m]))", "legendFormat": "req/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#2a78d6" },
          "custom": { "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Check pass rate",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * sum(k6_checks_total{check_result=\"true\"}) / sum(k6_checks_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "#d03b3b" },
              { "value": 95, "color": "#fab219" },
              { "value": 99, "color": "#0ca30c" }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
