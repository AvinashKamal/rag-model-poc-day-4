# LLM (via OpenRouter — only LLM key available, not a direct Anthropic key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5

# Vector DB (self-hosted via docker compose, no key needed)
QDRANT_URL=http://qdrant:6333

# Embeddings / reranking (self-hosted via docker compose TEI services, no key needed)
EMBEDDINGS_URL=http://embeddings:80
RERANKER_URL=http://reranker:80

# Observability (self-hosted via docker compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_API_KEY=

# Literature corpus sources
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Obsidian (for the live mcp-obsidian MCP server — requires Obsidian desktop
# running with the Local REST API community plugin enabled)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_API_KEY=

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
